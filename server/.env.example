# Copy to .env and fill in. Never commit .env - it is gitignored.

PORT=5000

# ---------------------------------------------------------------- auth ----
JWT_SECRET=your_jwt_secret_here

# Cognito (once the user pool exists)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# ------------------------------------------------------------- storage ----
# Local development against MongoDB. Swapped for DynamoDB on deploy.
MONGODB_URI=mongodb://localhost:27017/hackmatch

# DynamoDB / general AWS region for data + compute
AWS_REGION=ap-south-1

# ---------------------------------------------- competition extraction ----
# rules   = deterministic parser, no AWS account needed (default, always works)
# bedrock = real model call, silently falls back to rules on any error
EXTRACTION_PROVIDER=rules

# Bedrock lives in its own region - models are not available everywhere, and
# us-east-1 has the widest selection. It does NOT have to match AWS_REGION;
# cross-region Bedrock calls are normal.
BEDROCK_REGION=us-east-1

# Copy this exactly from Bedrock console -> Model access, once access is
# granted. Deliberately not defaulted: which models an account can call varies
# by account and region, and a wrong id fails at request time.
BEDROCK_MODEL_ID=
